  -
    name : BTN_RADModifImage
    identifier : 0x29b287d5246213a8
    internal_properties : 
    properties :
     x : 76
     y : 76
     width : 48
     height : 48
     accelerator_key : 65535
     tab_order : 2
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         // Clic sur BTN_RADModifImage
         
         //Sélection d'une image dans la galerie
         sCheminImage est une chaîne =AlbumSélecteur(albumImage)
         
         si sCheminImage <> "" alors
         	// Charge le fichier image dans le buffer
         	{IMG_Image..LiaisonFichier, indRubrique} = fChargeBuffer(sCheminImage)
         
         	//Met à jour l'affichage de l'image dans le champs
         	IMG_Image = sCheminImage
         
         
         	SI PAS EnModeSimulateur() alors
         		fSupprime(sCheminImage)
         	FIN
         FIN
        type : 18
      -
        type : 161
        enabled : false
