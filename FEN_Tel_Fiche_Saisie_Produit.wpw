 menu :
  name : MENU__Menu
  identifier : 0x29b287d423ed12fc
  internal_properties : 
  properties : {}
  options :
   -
     name : OPT_Enregristrer
     identifier : 0x29c6a4791572f43e
     internal_properties : 
     properties : {}
     code_elements :
      type_code : 26
      p_codes :
       -
         code : |1+
          // Bouton Enregistrer — version simplifiée
          SI SAI_Nom = "" ALORS
          	Erreur("Le nom du produit est obligatoire")
          	RETOUR
          FIN
          
          Produit.libelle		= SAI_Nom
          Produit.prix		= SAI_prix1
          Produit.categorie	= SAI_Description
          
          HAjoute(Produit)
          SI ErreurDétectée ALORS
          	HModifie(Produit)
          	SI ErreurDétectée ALORS
          		Erreur("Erreur : " + ErreurInfo())
          		RETOUR
          	FIN
          FIN
          Info("✅ Enregistré !")
          
         type : 32
   -
     name : OPT_Supprimer
     identifier : 0x29c6a3eb154dcb25
     internal_properties : 
     properties : {}
     code_elements :
      type_code : 26
      p_codes :
       -
         code : |1-
          HSupprime(Produit)
          SI ErreurDétectée ALORS
          	Erreur("Erreur suppression : " + ErreurInfo())
          	RETOUR
          FIN
          Info("Produit supprimé.")
          Ferme()
         type : 32
  code_elements :
   type_code : 26
   p_codes : []
