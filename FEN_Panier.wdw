         -
           code : |1+
            SI TABLE_Panier.COL_Qte <= 0 ALORS
            	TABLE_Panier.COL_Qte = 1
            	RETOUR
            FIN
            
            TABLE_Panier.COL_Sous = TABLE_Panier.COL_Qte * TABLE_Panier.COL_Prix
            
            nTotal est un réel = 0
            POUR i = 1 À TableOccurrence(TABLE_Panier)
            	nTotal += TABLE_Panier.COL_Sous[i]
            FIN
            LIB_Total = "Total : " + nTotal + " €"
