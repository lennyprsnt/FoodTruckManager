  -
    name : BTN_Supprimer
    identifier : 0x29e2194608526804
    internal_properties : 
    properties :
     x : 323
     y : 295
     width : 29
     height : 41
     anchor : 9
     anchor_to_content : 2
     accelerator_key : 65535
     tab_order : 1
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1-
         SI TableSelect(TABLE_Panier) = -1 ALORS
         	Erreur("Sélectionne une ligne")
         	RETOUR
         FIN
         
         TableSupprime(TABLE_Panier)
         
         nTotal est un réel = 0
         POUR i = 1 À TableOccurrence(TABLE_Panier)
         	nTotal += TABLE_Panier.COL_Sous[i]
         FIN
         LIB_Total = "Total : " + nTotal + " €"
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Commander
    identifier : 0x29e21f220a914bb2
    internal_properties : 
    properties :
     x : 8
     y : 336
     width : 112
     height : 34
     anchor : 1
     anchor_ratio_size_x : 0
     accelerator_key : 65535
     tab_order : 2
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1-
         SI TableOccurrence(TABLE_Panier) = 0 ALORS
         	Erreur("Panier vide !")
         	RETOUR
         FIN
         Ouvre(FEN_NouvelleCommande)
         Ferme()
        type : 18
      -
        type : 161
        enabled : false
