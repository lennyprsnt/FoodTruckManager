  internal_properties : IQAAACAAAAC4z/hstMRBK8udCH3f0TvOtlYtXu30dtZCDfbksFl+dexaCBCcQF0L5uSiFcmt0geAgnEMiYTV31bSw06pZzgsXLgsbCPpLT30nzaez7KOg7I9tp2XtebBP2eJFNA0PZW0
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre()
   -
     code : |1-
      TableSupprimeTout(TABLE_Panier)
      
      POUR i = 1 À TableauOccurrence(gsPanierNom)
      	TableAjoute(TABLE_Panier)
      	TABLE_Panier.COL_Nom[i]		= gsPanierNom[i]
      	TABLE_Panier.COL_Qte[i]		= gsPanierQte[i]
      	TABLE_Panier.COL_Prix[i]	= gsPanierPrix[i]
      	TABLE_Panier.COL_Sous[i]	= gsPanierPrix[i] * gsPanierQte[i]
      FIN
      gnTotal est un réel = 0
      
      POUR i = 1 À TableOccurrence(TABLE_Panier)
      	gnTotal += TABLE_Panier.COL_Sous[i]
      FIN
      
      LIB_Total = gnTotal
     type : 34
