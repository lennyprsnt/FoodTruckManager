  -
    name : LIB_Total
    identifier : 0x29e235c11645a9d3
    internal_properties : 
    properties :
     x : 8
     y : 290
     width : 120
     height : 19
     caption :
      fr-FR : "Total : "
     anchor : 1
     anchor_ratio_size_x : 0
     tab_stop : 0
     take_focus : 0
    type : 3
    code_elements :
     type_code : 2
     p_codes : []
  -
    name : BTN_Confirmer
    identifier : 0x29e235d61653fd04
    internal_properties : 
    properties :
     x : -32
     y : 328
     width : 160
     height : 48
     anchor : 1
     anchor_ratio_size_x : 0
     accelerator_key : 65535
     tab_order : 1
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1-
         HGèreIntégrité("*", Faux)
         
         SI TableOccurrence(TABLE_NouvelleCommande) = 0 ALORS
         	Erreur("Panier vide !")
         	RETOUR
         FIN
         
         nTotal est un réel = 0
         POUR i = 1 À TableOccurrence(TABLE_NouvelleCommande)
         	nTotal += TABLE_NouvelleCommande.COL_Sous[i]
         FIN
         
         Commande.dateCommande	= DateDuJour()
         Commande.total			= nTotal
         SI PAS HAjoute(Commande) ALORS
         	Erreur("Erreur : " + HErreurInfo())
         	RETOUR
         FIN
         
         HLitDernier(Commande)
         nIDCmd est un entier sur 8 octets = Commande.IDCommande
         
         POUR i = 1 À TableOccurrence(TABLE_NouvelleCommande)
         	LignedeCommande.IDCommande		= nIDCmd
         	LignedeCommande.quantite		= TABLE_NouvelleCommande.COL_Qte[i]
         	LignedeCommande.prixUnitaire	= TABLE_NouvelleCommande.COL_Sous[i]
         	LignedeCommande.IDProduit		= 0
         	SI PAS HAjoute(LignedeCommande) ALORS
         		Erreur("Erreur ligne " + i + " : " + HErreurInfo())
         		RETOUR
         	FIN
         FIN
         
         TableSupprimeTout(FEN_Panier.TABLE_Panier)
         Info("✅ Commande enregistrée !")
         Ferme()
        type : 18
      -
        type : 161
        enabled : false
  -
