      PROCEDURE MaFenêtre()
   -
     code : |1-
      
     type : 34
   -
     code : |1+
      TableSupprimeTout(TABLE_NouvelleCommande)
      
      nTotal est un réel = 0
      POUR i = 1 À TableOccurrence(FEN_Panier.TABLE_Panier)
      	TableAjoute(TABLE_NouvelleCommande)
      	TABLE_NouvelleCommande.COL_Nom[i]	= FEN_Panier.TABLE_Panier.COL_Nom[i]
      	TABLE_NouvelleCommande.COL_Qte[i]	= FEN_Panier.TABLE_Panier.COL_Qte[i]
      	TABLE_NouvelleCommande.COL_Sous[i]	= FEN_Panier.TABLE_Panier.COL_Sous[i]
      	nTotal += FEN_Panier.TABLE_Panier.COL_Sous[i]
      FIN
      
      LIB_Total = "Total à payer : " + nTotal + " €"
      
     type : 234
